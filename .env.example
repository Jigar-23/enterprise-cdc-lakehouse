# Canonical Enterprise CDC & Lakehouse Environment Configuration

# 1. PostgreSQL Source Database (OLTP ERP)
POSTGRES_HOST=postgres-source
POSTGRES_PORT=5432
POSTGRES_DB=erp_database
POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=erp_secure_password123

# 2. Event Streaming Broker (Redpanda - Kafka API Compatible)
KAFKA_BROKER=kafka:9092
KAFKA_EXTERNAL_BROKER=localhost:19092
KAFKA_GROUP_ID=cdc_lakehouse_consumer_group
KAFKA_TOPIC_PREFIX=erp_cdc

# 3. Debezium Kafka Connect Cluster
CONNECT_HOST=connect
CONNECT_PORT=8083
CONNECT_URL=http://localhost:8083

# 4. Lakehouse Storage Tiers
LAKEHOUSE_STORAGE_DIR=./lakehouse_storage
