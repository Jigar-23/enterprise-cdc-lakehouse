{
  "name": "postgres-cdc-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "plugin.name": "pgoutput",
    "database.hostname": "${POSTGRES_HOST:-postgres-source}",
    "database.port": "${POSTGRES_PORT:-5432}",
    "database.user": "${POSTGRES_USER:-erp_admin}",
    "database.password": "${POSTGRES_PASSWORD:-erp_secure_password123}",
    "database.dbname": "${POSTGRES_DB:-erp_database}",
    "topic.prefix": "${KAFKA_TOPIC_PREFIX:-erp_cdc}",
    "table.include.list": "public.orders,public.inventory",
    "publication.name": "cdc_publication",
    "slot.name": "${DEBEZIUM_SLOT:-debezium_slot}",
    "tombstones.on.delete": "false",
    "decimal.handling.mode": "double",
    "time.precision.mode": "connect",
    "snapshot.mode": "initial",
    "schema.history.internal.kafka.bootstrap.servers": "${KAFKA_BROKER:-kafka:9092}",
    "schema.history.internal.kafka.topic": "schema-changes.erp_cdc"
  }
}
